{
  "manifest_version": 3,
  "name": "babushkin-jam (local)",
  "version": "1.5.2",
  "description": "Неофициальное расширение: слушайте Яндекс Музыку вместе — общий трек, пауза и перемотка у всех в комнате.",
  "homepage_url": "https://github.com/imbabyboy/babushkin-jam",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.music.yandex.ru/*",
    "https://*.music.yandex.com/*",
    "https://*.music.yandex.by/*",
    "https://*.music.yandex.kz/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "babushkin-jam (local)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.music.yandex.ru/*",
        "https://*.music.yandex.com/*",
        "https://*.music.yandex.by/*",
        "https://*.music.yandex.kz/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.music.yandex.ru/*",
        "https://*.music.yandex.com/*",
        "https://*.music.yandex.by/*",
        "https://*.music.yandex.kz/*"
      ],
      "js": [
        "src/shared.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
