# Копия этого файла с настоящими ключами живёт только на сервере. Без ключа сервис показывает прочерк.
PORT=8790
LINKS_DB=/data/links-cache.db
RATE_LIMIT_PER_MINUTE=30

# Spotify: нужен Premium у владельца приложения
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# SoundCloud: нужен аккаунт Artist Pro
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# YouTube Data API v3: один поиск стоит 100 единиц из 10 000 в день
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCHES=90

APPLE_COUNTRY=US

# Без ключа разбирать страницы поиска YouTube, YouTube Music и SoundCloud. Условия сервисов это запрещают, возможна блокировка IP.
# PAGE_SEARCH=off выключает, тогда у них остаётся ссылка «Искать».
PAGE_SEARCH=on
PAGE_SEARCHES_PER_DAY=300
