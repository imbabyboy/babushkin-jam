# Порт 443 на VPS занят nginx с другим сайтом, поэтому HTTPS/WSS — на отдельном порту (JAM_HTTPS_PORT, по умолчанию 8443).
# Порт 80 нужен Let's Encrypt для проверки домена (HTTP-01): nginx передаёт её сюда.
# {$JAM_DOMAIN} и {$JAM_HTTPS_PORT} подставляют deploy.sh и deploy-links.sh. Вместо домена можно подставить список
# адресов (JAM_CADDY_SITES): адрес с http:// принимает запросы от nginx, остальные Caddy обслуживает по HTTPS сам.
# С JAM_SUBDOMAINS=1 к этому файлу добавляется Caddyfile.subdomains.
{
	http_port 80
	https_port {$JAM_HTTPS_PORT}
	# Перед Caddy стоит nginx: настоящий адрес клиента берём из его заголовка, чужим адресам не верим.
	servers {
		trusted_proxies static private_ranges
	}
}

(rooms) {
	reverse_proxy yandex-jam:8787
}

(links) {
	reverse_proxy song-links:8790 {
		# Сервис считает лимиты по последнему адресу в заголовке, поэтому оставляем в нём только клиента.
		header_up X-Forwarded-For {client_ip}
	}
}

# Всё на одном адресе: сервер комнат и сервис ссылок (deploy/deploy-links.sh) на /links/.
{$JAM_DOMAIN} {
	redir /links /links/
	handle_path /links/* {
		import links
	}
	handle {
		import rooms
	}
}
