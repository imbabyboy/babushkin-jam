# Скопируйте в deploy/.env и впишите свои значения. deploy/.env в git не попадает.
JAM_HOST=root@203.0.113.10
JAM_DOMAIN=jam.example.com
# Если порты 80 и 8443 на VPS заняты (см. docs/SELF_HOSTING.md):
# JAM_HTTPS_PORT=9443
# JAM_HTTP_PUBLISH=127.0.0.1:8081
# Адрес без порта через nginx на 443 (см. docs/SELF_HOSTING.md):
# JAM_CADDY_SITES="http://jam.example.com"
# Сервисы на поддоменах sync и share (см. docs/SELF_HOSTING.md):
# JAM_SUBDOMAINS=1
