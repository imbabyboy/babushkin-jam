{
  "name": "babushkin-jam-desktop",
  "productName": "babushkin-jam",
  "version": "0.0.0",
  "private": true,
  "description": "Яндекс Музыка и совместное прослушивание в отдельном приложении для macOS и Windows",
  "license": "MIT",
  "author": "babushkin-jam",
  "homepage": "https://github.com/imbabyboy/babushkin-jam",
  "main": "src/main.js",
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "start": "npm run bundle && electron .",
    "pack:mac-arm64": "npm run bundle && electron-builder --config electron-builder.config.js --mac dir --arm64",
    "dist:mac": "npm run bundle && electron-builder --config electron-builder.config.js --mac",
    "dist:win": "npm run bundle && electron-builder --config electron-builder.config.js --win",
    "test": "node --test test/updater.test.js"
  },
  "build": {
    "appId": "io.github.imbabyboy.babushkin-jam",
    "productName": "babushkin-jam",
    "directories": {
      "output": "../dist/native"
    },
    "files": [
      "src/**",
      "generated/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
